/**
 * Writes supabase/migrations/…_starter_collection.sql from the starter
 * collection in src/lib/gallery/starterCollection.ts, so the demo gallery
 * (/g/demo) and every new account's starter rooms come from the same data.
 *
 *   npm run db:starter-seed
 *
 * Runs with Node's built-in TypeScript support (Node 22.18+), no build step.
 * The SQL is idempotent: running it again updates rows instead of failing.
 */
import { writeFileSync } from "node:fs";
import { starterCollection } from "../src/lib/gallery/starterCollection.ts";

const OUT = "supabase/migrations/20261113120100_starter_collection.sql";

/** A SQL string literal (or NULL). */
const q = (value: string | number | boolean | null | undefined) => {
  if (value === null || value === undefined) return "null";
  if (typeof value === "number" || typeof value === "boolean") return String(value);
  return `'${value.replace(/'/g, "''")}'`;
};
const json = (value: unknown) => `${q(JSON.stringify(value))}::jsonb`;

const artworks = new Map(
  starterCollection.rooms.flatMap((r) => r.placements).map((p) => [p.artwork.id, p.artwork]),
);

const lines: string[] = [
  "-- Generated by scripts/generate-starter-seed.mts from",
  "-- src/lib/gallery/starterCollection.ts. Don't edit by hand: change the",
  "-- TypeScript and run `npm run db:starter-seed`.",
  "--",
  "-- The starter collection (HANDOVER.md §9): the catalogue artworks it uses,",
  "-- and the template rooms and placements copied into each new account.",
  "",
  "-- Catalogue artworks (shared by everyone).",
];

for (const a of artworks.values()) {
  lines.push(
    `insert into public.artworks (kind, source, source_id, title, artist, artist_meta, date_text, medium,
  dimensions_text, width_cm, height_cm, holder, description, description_credit, image_url,
  image_width, image_height, is_public_domain, attribution, source_url)
values ('catalogue', ${q(a.source)}, ${q(a.sourceId)}, ${q(a.title)}, ${q(a.artist)}, ${json(a.artistMeta)},
  ${q(a.dateText)}, ${q(a.medium)}, ${q(a.dimensionsText)}, ${q(a.widthCm)}, ${q(a.heightCm)},
  ${q(a.holder)}, ${q(a.description)}, ${q(a.descriptionCredit)}, ${q(a.imageUrl)},
  ${q(a.imageWidth)}, ${q(a.imageHeight)}, true, ${q(a.attribution)}, ${q(a.sourceUrl)})
on conflict (source, source_id) do update set
  title = excluded.title, artist = excluded.artist, artist_meta = excluded.artist_meta,
  date_text = excluded.date_text, medium = excluded.medium, dimensions_text = excluded.dimensions_text,
  width_cm = excluded.width_cm, height_cm = excluded.height_cm, holder = excluded.holder,
  description = excluded.description, description_credit = excluded.description_credit,
  image_url = excluded.image_url, image_width = excluded.image_width,
  image_height = excluded.image_height, attribution = excluded.attribution,
  source_url = excluded.source_url;`,
    "",
  );
}

lines.push(
  "-- Template rooms and placements (replaced wholesale).",
  "delete from public.starter_rooms;",
);
starterCollection.rooms.forEach((room, position) => {
  const theme = { version: 1, ...room.theme };
  lines.push(
    `insert into public.starter_rooms (position, slug, name, intro, theme)
values (${position}, ${q(room.slug)}, ${q(room.name)}, ${q(room.intro)}, ${json(theme)});`,
  );
  for (const p of room.placements) {
    lines.push(
      `insert into public.starter_placements (room_position, artwork_id, wall, x, y, frame, show_label)
select ${position}, a.id, ${q(p.wall)}, ${p.x}, ${p.y}, ${json({ version: 1, ...p.frame })}, ${p.showLabel}
from public.artworks a where a.source = ${q(p.artwork.source)} and a.source_id = ${q(p.artwork.sourceId)};`,
    );
  }
  lines.push("");
});

writeFileSync(OUT, lines.join("\n"));
console.log(`Wrote ${OUT}: ${artworks.size} artworks, ${starterCollection.rooms.length} rooms.`);
