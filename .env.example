# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real keys.

# "personal" (default) or "public". See HANDOVER.md §0b.
NEXT_PUBLIC_APP_MODE=personal

# Supabase (see "Setting up Supabase" in the README). Optional for the demo
# gallery; needed to sign in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. The secret key lets the server add new works to the shared
# catalogue; it bypasses row-level security, so keep it secret.
SUPABASE_SECRET_KEY=

# Sent with requests to museum APIs that ask who's calling (Wikimedia, AIC).
SALON_CONTACT_EMAIL=
